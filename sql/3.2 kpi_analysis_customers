-- STEP 5: CUSTOMER ANALYSIS
-- =========================================================


-- Q1. Find the top 10 customers by total revenue.
select c.customer_id,c.customer_name,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
join customers c on o.customer_id = c.customer_id
where o.order_status='Completed'
group by c.customer_id, c.customer_name
order by total_revenue desc
limit 10;


-- Q2. Find the number of orders placed by each customer.
select c.customer_id, c.customer_name, count(o.order_id) as order_count from customers c
left join orders o on c.customer_id = o.customer_id and o.order_status='Completed'
group by c.customer_id, c.customer_name;

-- Q3. Find customers who have placed at least 2 Completed orders.
select c.customer_id, c.customer_name, count(o.order_id) as completed_orders from customers c
join orders o on c.customer_id = o.customer_id
where o.order_status='Completed'
group by c.customer_id, c.customer_name
having count(o.order_id) >= 2;

-- Q4. Find customers whose total spending is greater than
-- the average customer spending.
with customer_spending as (
    select c.customer_id, c.customer_name, sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
    join customers c on o.customer_id = c.customer_id
    where o.order_status='Completed'
    group by c.customer_id, c.customer_name
)
select customer_id, customer_name, total_revenue from customer_spending
where total_revenue > (select avg(total_revenue) from customer_spending);

-- Q5. Calculate the percentage of customers who are
-- repeat customers.
-- A repeat customer = customer with 2 or more Completed orders.
with repeat_customers as (
    select c.customer_id from customers c
    join orders o on c.customer_id = o.customer_id
    where o.order_status='Completed'
    group by c.customer_id
    having count(o.order_id) >= 2
)
select (count(*) * 100.0 / (select count(*) from customers)) as repeat_customer_percentage
from repeat_customers;

-- Q6. Find the highest-spending customer in each city.
-- Return:
-- city
-- customer_name
-- total_revenue
with customer_revenue_highest as (
    select c.customer_id, c.customer_name, c.city, sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue,rank() over (partition by c.city 
    order by sum(o.quantity*o.unit_price*(1-o.discount)) desc) as revenue_rank from orders o
    join customers c on o.customer_id = c.customer_id
    where o.order_status='Completed'
    group by c.customer_id, c.customer_name, c.city
)
select city, customer_name, total_revenue from customer_revenue_highest
where revenue_rank = 1;

-- Q7. Classify customers into spending segments:
-- High Value   = revenue >= 100000
-- Medium Value = revenue >= 50000 and < 100000
-- Low Value    = revenue < 50000
-- Return:
-- customer_id
-- customer_name
-- total_revenue
-- customer_segment
select c.customer_id, c.customer_name, sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue,case
    when sum(o.quantity*o.unit_price*(1-o.discount)) >= 100000 then 'High Value'
    when sum(o.quantity*o.unit_price*(1-o.discount)) >= 50000 then 'Medium Value'
    else 'Low Value'
end as customer_segment
from customers c
join orders o on c.customer_id = o.customer_id
where o.order_status='Completed'
group by c.customer_id, c.customer_name;

-- Q8. Find customers who placed their first Completed order
-- during each month of 2025.
-- Return:
-- month
-- number_of_new_customers
with first_orders as (
    select customer_id, min(order_date) as first_order_date from orders
    where order_status='Completed'
    group by customer_id
) 
select strftime('%Y-%m', first_order_date) as month, count(customer_id) as number_of_new_customers from first_orders
where first_order_date >= '2025-01-01' and first_order_date < '2026-01-01'
group by month;

-- Q9. For each customer, calculate:
-- customer_id
-- total_revenue
-- total_orders
-- average_order_value
-- revenue_rank
-- Rank customers from highest to lowest revenue.
with ranked_customer as (
    select c.customer_id, sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue, count(o.order_id) as total_orders,
    (sum(o.quantity*o.unit_price*(1-o.discount))/count(o.order_id)) as average_order_value,
    rank() over (order by sum(o.quantity*o.unit_price*(1-o.discount)) desc) as revenue_rank
    from customers c
    join orders o on c.customer_id = o.customer_id
    where o.order_status='Completed'
    group by c.customer_id
)
select customer_id, total_revenue, total_orders, average_order_value, revenue_rank from ranked_customer;
