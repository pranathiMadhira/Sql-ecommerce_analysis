-- STEP 4: CATEGORY & PRODUCT ANALYSIS
-- =========================================================


-- Q1. Show the total revenue generated by each product category.
select p.category,sum(o.quantity *o.unit_price*(1-o.discount)) as total_revenue from orders o 
join products p on o.product_id = p.product_id 
where o.order_status='Completed'
group by p.category;


-- Q2. Show the total number of orders and total quantity sold
-- for each product category.
select p.category,count(o.order_id) as total_orders,sum(o.quantity) as total_quantity_sold from orders o
join products p on o.product_id = p.product_id
where o.order_status='Completed'
group by p.category;

-- Q3. Find the top 10 products by total revenue.
select p.product_name,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
join products p on o.product_id = p.product_id
where o.order_status='Completed'
group by p.product_name order by total_revenue desc limit 10;


-- Q4. Find the top 3 products by revenue within each category.
with rank_products as(
    select p.product_name,p.category,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue,
    rank() over(partition by p.category order by sum(o.quantity*o.unit_price*(1-o.discount)) desc) as revenue_rank from orders o
    join products p on o.product_id = p.product_id
    where o.order_status='Completed'
    group by p.category, p.product_name
)
select product_name,category,total_revenue from rank_products where revenue_rank <= 3;


-- Q5. Which categories have generated more revenue than
--the average category revenue?
with category_revenue as(
    select p.category,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
    join products p on o.product_id = p.product_id
    where o.order_status='Completed'
    group by p.category
)
select category,total_revenue from category_revenue
where total_revenue > (select avg(total_revenue) from category_revenue);

-- Q6. Find the category with the highest average order value.
select p.category,avg(o.quantity*o.unit_price*(1-o.discount)) as average_order_value from orders o
join products p on o.product_id = p.product_id
where o.order_status='Completed'
group by p.category;

-- Q7. For each category, calculate its percentage contribution
--to the company's total revenue.
with category_revenue as(
    select p.category,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
    join products p on o.product_id = p.product_id
    where o.order_status='Completed'
    group by p.category
)
,total_revenue as(
    select sum(total_revenue) as total_revenue from category_revenue
)
select c.category,
       c.total_revenue,
       t.total_revenue as company_total_revenue,
       (c.total_revenue / t.total_revenue) * 100 as revenue_percentage
from category_revenue c
cross join total_revenue t;

-- Q8. Find products that have generated revenue above
-- the overall average product revenue.
with product_revenue as(
    select p.product_name,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue from orders o
    join products p on o.product_id = p.product_id
    where o.order_status='Completed'
    group by p.product_name
)
,average_product_revenue as(
    select avg(total_revenue) as average_revenue from product_revenue
)
select product_name from product_revenue
where total_revenue > (select average_revenue from average_product_revenue);

-- Q9. Find the highest-revenue product in each category.
with ranked_products as (
select p.category,p.product_name,sum(o.quantity*o.unit_price*(1-o.discount)) as total_revenue,
       rank() over (partition by p.category order by sum(o.quantity*o.unit_price*(1-o.discount)) desc) as revenue_rank
from orders o
join products p on o.product_id = p.product_id
where o.order_status='Completed'
group by p.category, p.product_name
)
select category, product_name, total_revenue from ranked_products where revenue_rank = 1;


